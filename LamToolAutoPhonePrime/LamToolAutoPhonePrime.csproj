  <ItemGroup>
    <PackageReference Include="DeviceId.Windows" Version="6.9.0" />
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.82" />
    <PackageReference Include="PublishAotCompressed" Version="1.0.5" />
    <PackageReference Include="VC-LTL" Version="5.2.2" />
    <PackageReference Include="WinFormsComInterop" Version="0.5.0" />
    <PackageReference Include="YY-Thunks" Version="1.1.7" />
  </ItemGroup>
	<!-- Trimming Rules -->
	<ItemGroup>
		<TrimmerRootAssembly Include="System.Drawing.Common" />
		<TrimmerRootAssembly Include="System.Resources.Extensions" />
		<TrimmerRootAssembly Include="System.ComponentModel.TypeConverter" />
		<TrimmerRootAssembly Include="System.ComponentModel" />
		<TrimmerRootAssembly Include="System.Windows.Forms" />
		<TrimmerRootAssembly Include="mscorlib" />
	</ItemGroup>
	<!-- AOT Reflection Config -->
	<ItemGroup>
		<RdXmlFile Include="rd.xml" />
		<RdXmlFile Include="Forms.xml" />
	</ItemGroup>
	<!-- Force WinForms binding support = true (overrides SDK default of false for trimmed builds) -->
	<PropertyGroup>
		<_WinFormsBindingSupport>true</_WinFormsBindingSupport>
	</PropertyGroup>

	<Target Name="PreserveReflectionForAutoAndroid" BeforeTargets="PrepareForILLink">
		<ItemGroup>
			<DynamicDependency Include="AutoAndroid.DeviceModel" DynamicallyAccessedMemberTypes="All" />
		</ItemGroup>
	</Target>
	<!-- Optional: workaround for crash in parallel merge sort -->
	<ItemGroup>
		<IlcCompileInput Include="--parallelism:1" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\AntdUI.EmojiFluentFlat\AntdUI.EmojiFluentFlat.csproj" />
	  <ProjectReference Include="..\AntdUI\AntdUI.csproj" />
	  <ProjectReference Include="..\AutoAndroid\AutoAndroid.csproj" />
	  <ProjectReference Include="..\ScrcpyNet\ScrcpyNet.csproj" />
	  <ProjectReference Include="..\Sunny.Subd.Core\Sunny.Subd.Core.csproj" />
	  <ProjectReference Include="..\Sunny.Subdy.Common\Sunny.Subdy.Common.csproj" />
	  <ProjectReference Include="..\Sunny.Subdy.Data\Sunny.Subdy.Data.csproj" />
	  <ProjectReference Include="..\Sunny.Subdy.Server\Sunny.Subdy.Server.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <Resource Include="Resources\logo_lamtool_v3_dark_16.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Resource>
	</ItemGroup>

	<PropertyGroup>
		<HttpRequestLibProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\HttpRequestLib\HttpRequestLib\HttpRequestLib.vcxproj'))</HttpRequestLibProjectPath>
		<HttpRequestLibSolutionDir>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))))</HttpRequestLibSolutionDir>
		<HttpRequestLibNativePlatform Condition="'$(Platform)' == 'x86'">Win32</HttpRequestLibNativePlatform>
		<HttpRequestLibNativePlatform Condition="'$(Platform)' == 'x64'">x64</HttpRequestLibNativePlatform>
		<HttpRequestLibNativePlatform Condition="'$(HttpRequestLibNativePlatform)' == ''">x64</HttpRequestLibNativePlatform>
		<HttpRequestLibX64DllPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\x64\$(Configuration)\HttpRequestLib.dll'))</HttpRequestLibX64DllPath>
		<HttpRequestLibWin32DllPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Win32\$(Configuration)\HttpRequestLib.dll'))</HttpRequestLibWin32DllPath>
		<HttpRequestLibWin32LegacyDllPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\$(Configuration)\HttpRequestLib.dll'))</HttpRequestLibWin32LegacyDllPath>
		<VsWherePath>$([System.IO.Path]::Combine($([System.Environment]::GetFolderPath(SpecialFolder.ProgramFilesX86)), 'Microsoft Visual Studio', 'Installer', 'vswhere.exe'))</VsWherePath>
		<HttpRequestLibMsBuildLookupFile>$(BaseIntermediateOutputPath)HttpRequestLib.$(Configuration).$(Platform).msbuild.path.txt</HttpRequestLibMsBuildLookupFile>
	</PropertyGroup>

	<Target Name="ResolveHttpRequestLibMsBuildPath" Condition="'$(HttpRequestLibMsBuildPath)' == ''">
		<MakeDir Directories="$(BaseIntermediateOutputPath)" />
		<Exec Command="&quot;$(VsWherePath)&quot; -latest -requires Microsoft.Component.MSBuild -find &quot;MSBuild\**\Bin\MSBuild.exe&quot; &gt; &quot;$(HttpRequestLibMsBuildLookupFile)&quot;" Condition="Exists('$(VsWherePath)')" />
		<ReadLinesFromFile File="$(HttpRequestLibMsBuildLookupFile)" Condition="Exists('$(HttpRequestLibMsBuildLookupFile)')">
			<Output TaskParameter="Lines" ItemName="HttpRequestLibMsBuildPathCandidate" />
		</ReadLinesFromFile>
		<PropertyGroup>
			<HttpRequestLibMsBuildPath>@(HttpRequestLibMsBuildPathCandidate->'%(Identity)', '')</HttpRequestLibMsBuildPath>
		</PropertyGroup>
		<Error Condition="'$(HttpRequestLibMsBuildPath)' == ''" Text="Could not locate Visual Studio MSBuild.exe to build HttpRequestLib. Expected vswhere at '$(VsWherePath)'." />
	</Target>

	<Target Name="BuildHttpRequestLibIfMissing" DependsOnTargets="ResolveHttpRequestLibMsBuildPath" Condition="('$(HttpRequestLibNativePlatform)' == 'x64' and !Exists('$(HttpRequestLibX64DllPath)')) or ('$(HttpRequestLibNativePlatform)' == 'Win32' and !Exists('$(HttpRequestLibWin32LegacyDllPath)') and !Exists('$(HttpRequestLibWin32DllPath)'))">
		<Message Text="Building HttpRequestLib ($(Configuration)|$(HttpRequestLibNativePlatform)) before LamToolAutoPhonePrime..." Importance="high" />
		<Exec Command="&quot;$(HttpRequestLibMsBuildPath)&quot; &quot;$(HttpRequestLibProjectPath)&quot; /t:Build /p:Configuration=$(Configuration) /p:Platform=$(HttpRequestLibNativePlatform) /p:SolutionDir=$(HttpRequestLibSolutionDir) /nologo" />
		<Error Condition="('$(HttpRequestLibNativePlatform)' == 'x64' and !Exists('$(HttpRequestLibX64DllPath)')) or ('$(HttpRequestLibNativePlatform)' == 'Win32' and !Exists('$(HttpRequestLibWin32LegacyDllPath)') and !Exists('$(HttpRequestLibWin32DllPath)'))" Text="HttpRequestLib.dll was not found after the native build. Checked: $(HttpRequestLibX64DllPath), $(HttpRequestLibWin32LegacyDllPath), $(HttpRequestLibWin32DllPath)." />
	</Target>

	<Target Name="BuildAndCopyHttpRequestLib" BeforeTargets="Build" DependsOnTargets="BuildHttpRequestLibIfMissing">
		<ItemGroup>
			<HttpRequestLibCandidate Include="$(HttpRequestLibX64DllPath)" Condition="'$(HttpRequestLibNativePlatform)' == 'x64'" />
			<HttpRequestLibCandidate Include="$(HttpRequestLibWin32LegacyDllPath)" Condition="'$(HttpRequestLibNativePlatform)' == 'Win32'" />
			<HttpRequestLibCandidate Include="$(HttpRequestLibWin32DllPath)" Condition="'$(HttpRequestLibNativePlatform)' == 'Win32'" />
			<ResolvedHttpRequestLibCandidate Include="@(HttpRequestLibCandidate)" Condition="Exists('%(Identity)')" />
		</ItemGroup>
		<Error Condition="'@(ResolvedHttpRequestLibCandidate)' == ''" Text="HttpRequestLib.dll was not found after the native build. Checked: @(HttpRequestLibCandidate, ', ')." />
		<Copy SourceFiles="@(ResolvedHttpRequestLibCandidate)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
		<Message Text="Copied HttpRequestLib.dll to $(OutDir)." Importance="high" />
	</Target>

	<!-- Copy ScrcpyNet native DLLs (FFmpeg, SDL2, adb, scrcpy-server) vào output -->
	<Target Name="CopyScrcpyNativeDeps" AfterTargets="Build">
		<ItemGroup>
			<ScrcpyNativeDep Include="$(MSBuildProjectDirectory)\..\ScrcpyNet\bin\$(Configuration)\netstandard2.1\ScrcpyNet\*.*" />
		</ItemGroup>
		<MakeDir Directories="$(OutDir)ScrcpyNet" />
		<Copy SourceFiles="@(ScrcpyNativeDep)" DestinationFolder="$(OutDir)ScrcpyNet" SkipUnchangedFiles="true" Condition="'@(ScrcpyNativeDep)' != ''" />
		<Message Text="Copied ScrcpyNet native DLLs to $(OutDir)ScrcpyNet." Importance="high" Condition="'@(ScrcpyNativeDep)' != ''" />
		<Warning Text="ScrcpyNet native DLLs not found. Build ScrcpyNet project first." Condition="'@(ScrcpyNativeDep)' == ''" />
	</Target>

	<!-- Build GolikeHelper (Python PyInstaller) và copy vào output -->
	<PropertyGroup>
		<LTPhoneHelperDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\LTPhoneHelper'))</LTPhoneHelperDir>
		<LTPhoneHelperExe>$(LTPhoneHelperDir)\dist\GolikeHelper.exe</LTPhoneHelperExe>
	</PropertyGroup>

	<Target Name="BuildLTPhoneHelper" BeforeTargets="Build">
		<Message Text="Building GolikeHelper..." Importance="high" />
		<Exec Command="python build.py" WorkingDirectory="$(LTPhoneHelperDir)" IgnoreExitCode="true" Condition="Exists('$(LTPhoneHelperDir)\build.py')" />
		<Warning Text="GolikeHelper.exe not found after build. Skipping copy." Condition="!Exists('$(LTPhoneHelperExe)')" />
	</Target>

	<Target Name="CopyLTPhoneHelper" AfterTargets="BuildLTPhoneHelper" BeforeTargets="Build" Condition="Exists('$(LTPhoneHelperExe)')">
		<Copy SourceFiles="$(LTPhoneHelperExe)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
		<Message Text="Copied GolikeHelper.exe to $(OutDir)." Importance="high" />
	</Target>

	<!-- Build ORC-Helper-Python (PyInstaller onefile) và copy vào output -->
	<PropertyGroup>
		<OrcHelperDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\ORC-Helper-Python'))</OrcHelperDir>
		<OrcHelperExe>$(OrcHelperDir)\dist\ocr_helper.exe</OrcHelperExe>
	</PropertyGroup>

	<Target Name="BuildOrcHelper" BeforeTargets="Build">
		<Message Text="Building ORC-Helper-Python (onefile)..." Importance="high" />
		<Exec Command="pyinstaller build/ocr_helper.spec --clean --distpath dist/" WorkingDirectory="$(OrcHelperDir)" IgnoreExitCode="true" Condition="Exists('$(OrcHelperDir)\build\ocr_helper.spec')" />
		<Warning Text="ocr_helper.exe not found after build. Skipping copy." Condition="!Exists('$(OrcHelperExe)')" />
	</Target>

	<Target Name="CopyOrcHelper" AfterTargets="BuildOrcHelper" BeforeTargets="Build" Condition="Exists('$(OrcHelperExe)')">
		<Copy SourceFiles="$(OrcHelperExe)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
		<Message Text="Copied ocr_helper.exe to $(OutDir)." Importance="high" />
	</Target>

	<!-- Build ViewControl (AOT standalone .exe) và copy vào output -->
	<PropertyGroup>
		<ViewControlProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\View-Control\ViewControl.csproj'))</ViewControlProjectPath>
		<ViewControlExe>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\View-Control\bin\publish\Golike-Android-View.exe'))</ViewControlExe>
	</PropertyGroup>

	<Target Name="BuildViewControl" BeforeTargets="Build" Condition="Exists('$(ViewControlProjectPath)')">
		<Message Text="Building ViewControl..." Importance="high" />
		<Exec Command="dotnet publish &quot;$(ViewControlProjectPath)&quot; -r win-x64 -c Release --output &quot;$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\View-Control\bin\publish'))&quot; /p:PublishAot=false /p:PublishSingleFile=true /p:SelfContained=true /p:IncludeNativeLibrariesForSelfExtract=true /nologo" IgnoreExitCode="true" />
		<Warning Text="Golike-Android-View.exe not found after build. Skipping copy." Condition="!Exists('$(ViewControlExe)')" />
	</Target>

	<Target Name="CopyViewControl" AfterTargets="BuildViewControl" BeforeTargets="Build" Condition="Exists('$(ViewControlExe)')">
		<Copy SourceFiles="$(ViewControlExe)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
		<Message Text="Copied Golike-Android-View.exe to $(OutDir)." Importance="high" />
	</Target>

	<!--
	  Đọc build counter và tính BuildNumber TRƯỚC khi MSBuild resolve assembly version.
	  Đặt trong Target (không phải <PropertyGroup>) để tránh ReadAllText chạy ở
	  evaluation-time (lúc VS load designer/IntelliSense → file có thể bị lock).
	  ContinueOnError=true để designer/IntelliSense không fail nếu file đang bị giữ.
	-->
	<Target Name="ResolveBuildCounter"
			BeforeTargets="GetAssemblyVersion;BeforeBuild;CoreCompile"
			Condition="Exists('$(BuildCounterFile)')">
		<ReadLinesFromFile File="$(BuildCounterFile)" ContinueOnError="true">
			<Output TaskParameter="Lines" PropertyName="_BuildCounterRaw" />
		</ReadLinesFromFile>
		<PropertyGroup Condition="'$(_BuildCounterRaw)' != ''">
			<_BuildCounterDate>$(_BuildCounterRaw.Split('|')[0])</_BuildCounterDate>
			<_BuildCounterValue Condition="$(_BuildCounterRaw.Contains('|'))">$(_BuildCounterRaw.Split('|')[1])</_BuildCounterValue>
			<BuildNumber Condition="'$(_BuildCounterDate)' == '$(BuildDateToday)' and '$(_BuildCounterValue)' != ''">$([MSBuild]::Add($(_BuildCounterValue), 1))</BuildNumber>
			<BuildNumber Condition="'$(BuildNumber)' == '0' or '$(BuildNumber)' == ''">1</BuildNumber>
			<CurrentTime>$(BuildDateToday).$(BuildNumber)</CurrentTime>
			<Version>$(CurrentTime)</Version>
			<AssemblyVersion>$(CurrentTime)</AssemblyVersion>
			<FileVersion>$(CurrentTime)</FileVersion>
		</PropertyGroup>
	</Target>

	<!-- Khi file chưa tồn tại, vẫn cần BuildNumber=1 cho lần build đầu -->
	<Target Name="ResolveBuildCounterFirstRun"
			BeforeTargets="GetAssemblyVersion;BeforeBuild;CoreCompile"
			Condition="!Exists('$(BuildCounterFile)')">
		<PropertyGroup>
			<BuildNumber>1</BuildNumber>
			<CurrentTime>$(BuildDateToday).$(BuildNumber)</CurrentTime>
			<Version>$(CurrentTime)</Version>
			<AssemblyVersion>$(CurrentTime)</AssemblyVersion>
			<FileVersion>$(CurrentTime)</FileVersion>
		</PropertyGroup>
	</Target>

	<!-- Lưu lại build counter sau khi build thành công để lần sau tăng tiếp -->
	<Target Name="PersistBuildCounter" AfterTargets="Build">
		<WriteLinesToFile File="$(BuildCounterFile)" Lines="$(BuildDateToday)|$(BuildNumber)" Overwrite="true" ContinueOnError="true" />
		<Message Text="📌 Build version: $(CurrentTime)" Importance="high" />
	</Target>

	<Target Name="CleanObjWhenRun" AfterTargets="Build" Condition="'$(RunConfiguration)' != ''">
		<Message Text="🧹 Dọn thư mục obj sau khi chạy build..." Importance="high" />
		<RemoveDir Directories="$(BaseIntermediateOutputPath)" />
	</Target>
</Project>
