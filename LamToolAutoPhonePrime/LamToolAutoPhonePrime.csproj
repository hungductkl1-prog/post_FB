<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>



	  <!-- Debug settings -->
	  <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
	  <DebugType>portable</DebugType>
	  <DebugSymbols>true</DebugSymbols>
	  <Optimize>false</Optimize>

	  <!-- Native AOT -->
	  <PublishAot>true</PublishAot>
	  <InvariantGlobalization>false</InvariantGlobalization>
	  <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
	  <UseWindowsForms>true</UseWindowsForms>
	  <CustomResourceTypesSupport>true</CustomResourceTypesSupport>
	  <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
	  <WindowsSupportedOSPlatformVersion>5.1</WindowsSupportedOSPlatformVersion>
	  <TargetPlatformMinVersion>5.1</TargetPlatformMinVersion>
	  <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		  <OptimizationPreference>Size</OptimizationPreference>
	  <PublishLzmaCompressed>false</PublishLzmaCompressed>
	  <!-- Auto Versioning: yy.MM.dd.<build> — build counter tăng dần trong ngày, reset khi sang ngày mới -->
	  <BuildCounterFile>$(MSBuildProjectDirectory)\.build-counter</BuildCounterFile>
	  <BuildDateToday>$([System.DateTime]::Now.ToString("yy.MM.dd"))</BuildDateToday>
	  <!-- Default version dùng khi chưa resolve được counter (designer / IntelliSense / file đang lock) -->
	  <BuildNumber>0</BuildNumber>
	  <CurrentTime>$(BuildDateToday).$(BuildNumber)</CurrentTime>
	  <Version>$(CurrentTime)</Version>
	  <AssemblyVersion>$(CurrentTime)</AssemblyVersion>
	  <FileVersion>$(CurrentTime)</FileVersion>
	  <AssemblyName>GolikePhoneFarm</AssemblyName>
	  <Product>GolikePhoneFarm</Product>
	  <Company>Golike</Company>
	  <Copyright>Golike</Copyright>
	  <PackageId>GolikePhoneFarm</PackageId>
	  <Title>GolikePhoneFarm</Title>
	  <PackageProjectUrl>https://golike.net/</PackageProjectUrl>
	  <ApplicationIcon>Resources\logo_lamtool_v3_dark_16.ico</ApplicationIcon>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Form1.cs~RF5742302.TMP" />
    <None Remove="Form1.Designer.cs~RF55c9fe8.TMP" />
    <None Remove="fShowDevice.resx~RF58355c2.TMP" />
    <None Remove="Resources\icons8_facebook_40.png" />
    <None Remove="Resources\icons8_telegram_48.png" />
    <None Remove="Resources\icons8_tiktok_40.png" />
    <None Remove="Resources\icons8_youtube_40.png" />
    <None Remove="Resources\icons8_zalo_40.png" />
    <None Remove="Resources\logo_lamtool_v3_dark_16.png" />
    <None Remove="ucThongBaoDeviceView.resx~RFa4f8141.TMP" />
    <None Remove="Utils\ucNotificationMessage.cs~RF13fe9d1c.TMP" />
    <None Remove="Views\Controls\obntibxz.ejt~" />
    <None Remove="Views\Controls\ucdgvAccount.resx~RF151a5754.TMP" />
    <None Remove="Views\Controls\ucManagerDevices.cs~RF14b2b155.TMP" />
    <None Remove="Views\Controls\yeakuel5.214~" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\logo_lamtool_v3_dark_16.ico" />
  </ItemGroup>
	

  <ItemGroup>
    <Compile Update="Views\Forms\fAddUsercontrol.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Forms\fSelectBrandModel.cs">
      <SubType>Form</SubType>
