{
    "kiroAgent.agentAutonomy": "Autopilot",
    "kiroAgent.enableDebugLogs": true,
    "kiroAgent.enableCodebaseIndexing": true,
    "kiroAgent.enableTabAutocomplete": true,
    "workbench.commandPalette.experimental.suggestCommands": true,
    "workbench.commandPalette.preserveInput": true,
    "workbench.experimental.share.enabled": true,
    "workbench.experimental.cloudChanges.partialMatches.enabled": true,
    "workbench.list.smoothScrolling": true,
    "workbench.list.scrollByPage": true,
    "workbench.quickOpen.preserveInput": true,
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.excludeDirty": true,
    "workbench.editor.limit.perEditorGroup": true,
    "workbench.editor.preferHistoryBasedLanguageDetection": true,
    "workbench.editor.pinnedTabsOnSeparateRow": true,
    "workbench.editor.revealIfOpen": true,
    "workbench.editor.scrollToSwitchTabs": true,
    "workbench.editor.sharedViewState": true,
    "workbench.editor.wrapTabs": true,
    "workbench.settings.enableNaturalLanguageSearch": true,
    "workbench.settings.openDefaultKeybindings": true,
    "workbench.settings.openDefaultSettings": true,
    "screencastMode.keyboardOptions": {
        "showCommandGroups": true
    },
    "window.autoDetectColorScheme": false,
    "accessibility.signalOptions.debouncePositionChanges": true,
    "search.searchEditor.focusResultsOnSearch": true,
    "search.searchEditor.reusePriorSearchConfiguration": true,
    "search.seedWithNearestWord": true,
    "search.seedOnFocus": true,
    "search.smartCase": true,
    "search.useGlobalIgnoreFiles": true,
    "search.useParentIgnoreFiles": true,
    "debug.allowBreakpointsEverywhere": true,
    "debug.closeReadonlyTabsOnEnd": true,
    "debug.console.closeOnEnd": true,
    "debug.hideSlowPreLaunchWarning": true,
    "debug.hideLauncherWhileDebugging": true,
    "testing.alwaysRevealTestOnStateChange": true,
    "testing.automaticallyOpenPeekViewDuringAutoRun": true,
    "testing.coverageToolbarEnabled": true,
    "testing.followRunningTest": true,
    "testing.showAllMessages": true,
    "scm.alwaysShowActions": true,
    "scm.alwaysShowRepositories": true
}