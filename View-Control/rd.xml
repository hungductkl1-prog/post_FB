			<Type Name="System.Windows.Forms.CurrencyManager" Dynamic="Required All" />
			<Type Name="System.Windows.Forms.PropertyManager" Dynamic="Required All" />
			<Type Name="System.Windows.Forms.ContainerControl" Dynamic="Required All" />
		</Assembly>

		<!-- Project assemblies -->
		<Assembly Name="AntdUI" Dynamic="Required All" />
		<Assembly Name="AutoAndroid" Dynamic="Required All" />
		<Assembly Name="Sunny.Subdy.Common" Dynamic="Required All" />
		<Assembly Name="Sunny.Subdy.Data" Dynamic="Required All" />

		<!-- Models -->
		<Assembly Name="Sunny.Subdy.Data">
			<Type Name="Sunny.Subdy.Data.Models.DeviceModel" Dynamic="Required All" />
		</Assembly>

		<!-- ViewControl forms (assembly name = AssemblyName trong csproj = Golike-Android-View) -->
		<Assembly Name="Golike-Android-View">
			<Type Name="ViewControl.fSingleView" Dynamic="Required All" Preserve="All" />
